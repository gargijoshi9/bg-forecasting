# ==========================================
# 1. Raw & Clinical Data (Strictly Ignored)
# ==========================================
data/raw/*
!data/raw/.gitkeep
*.xml

# ==========================================
# 2. Processed Personal Health Data (Strictly Ignored)
# ==========================================
data/processed/*
!data/processed/.gitkeep

# ==========================================
# 3. Model Weights & Serialized Artifacts
# ==========================================
# Globally ignore Python pickles and PyTorch weights
*.pkl
*.pt
*.pth

# Models directory: ignore by default, whitelist metadata.json and XGBoost JSON checkpoints
models/*
!models/.gitkeep
!models/metadata.json
!models/xgboost_*.json

# ==========================================
# 4. Research Results & Visualizations
# ==========================================
# Keep personal visualization plots private (contain personal curves, dates & stress traces)
results/*.png

# Allow aggregated research benchmark CSVs
!results/feature_ablation_study.csv
!results/forecasting_experiments.csv
!results/sequence_generation_audit.csv
!results/.gitkeep

# ==========================================
# 5. Environment & Temporary Files
# ==========================================
venv/
.env
__pycache__/
*.py[cod]
*$py.class
.ipynb_checkpoints/
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
.DS_Store
Thumbs.db
